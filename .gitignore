# buNtu — fichiers ignorés par Git
#
# Workspace Cargo, console SvelteKit (`ui/`) et lanceur npx (`npx/`).

# --- Rust / Cargo ---
/target/
**/*.rs.bk
*.pdb
# Cargo.lock est volontairement versionné : buNtu est un binaire, pas une bibliothèque.

# --- Node / interface (SvelteKit, lanceur npx) ---
node_modules/
/ui/.svelte-kit/
/ui/build/
/ui/dist/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Couverture et profils ---
/coverage/
lcov.info
*.profraw
*.profdata

# --- Données d'exécution (SQLite) ---
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# --- Secrets et environnement local ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Journaux et fichiers temporaires ---
*.log
*.tmp
/tmp/

# --- Système et éditeurs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
